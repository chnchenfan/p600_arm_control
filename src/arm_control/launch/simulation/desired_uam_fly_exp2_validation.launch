<?xml version="1.0"?>
<launch>
    <!--
        实验二自动验证套件入口：
        1. 先做 5 组多姿态静态 IK 复测；
        2. 静态组全部通过后，再做虚拟基座扰动测试；
        3. 这里的虚拟扰动只用于验证补偿逻辑稳定性，不能替代真实小扰动复验。
    -->
    <rosparam file="$(find uam_message)/config/arm_info_init.yaml" command="load" />

    <node pkg="arm_control" type="motors_simulation" name="motors_simulation" output="screen" />
    <node pkg="arm_control" type="serial_" name="serial_" output="screen" />

    <node pkg="arm_control" type="uam_desired_exp2_static_ik" name="uam_desired_exp2_static_ik" output="screen">
        <param name="test_mode" value="validation_suite" />
        <param name="base_pose_topic" value="/vrpn_client_node/arm_base/pose" />
        <param name="ee_pose_topic" value="/vrpn_client_node/arm_target/pose" />

        <param name="settle_time" value="3.0" />
        <param name="test_duration_sec" value="20.0" />
        <param name="static_case_duration_sec" value="10.0" />
        <param name="preposition_timeout_sec" value="20.0" />
        <param name="preposition_tolerance_deg" value="1.0" />
        <param name="preposition_confirm_sec" value="0.5" />
        <param name="hold_error_pass_m" value="0.01" />

        <param name="L1_m" value="0.154859" />
        <param name="L2_m" value="0.223951" />

        <!-- 这组值来自 data/calibration/static/20260408_1 的 base_xyz_dq_l2 拟合，适用前提是已采用“arm1 增大对应 -y”的几何约定。 -->
        <param name="arm_base_offset_x_m" value="0.024759" />
        <param name="arm_base_offset_y_m" value="0.006501" />
        <param name="arm_base_offset_z_m" value="-0.005065" />
        <param name="arm1_zero_offset_deg" value="-7.011313" />
        <param name="arm2_zero_offset_deg" value="-5.434880" />

        <param name="use_initial_ee_hold" value="true" />
        <param name="hold_freeze_samples" value="5" />
        <param name="exp2_hold_ee_x" value="0.0" />
        <param name="exp2_hold_ee_y" value="0.0" />
        <param name="exp2_hold_ee_z" value="0.0" />

        <param name="ee_outer_kp" value="0.25" />
        <param name="ee_outer_clip_m" value="0.03" />

        <param name="pose_timeout_sec" value="0.3" />
        <param name="eps_r_m" value="0.01" />
        <param name="eps_xy_m" value="0.015" />
        <param name="ik_fail_limit" value="10" />
        <param name="pose_loss_limit" value="10" />
        <param name="arm1_dot_max_deg_s" value="90.0" />
        <param name="arm2_dot_max_deg_s" value="90.0" />
    </node>
</launch>
