<?xml version="1.0"?>
<launch>
    <rosparam file="$(find uam_message)/config/arm_info_init.yaml" command="load" />
    <node pkg="arm_control" type="motors_simulation" name="motors_simulation" output="screen" />
    <node pkg="arm_control" type="uam_desired_exp3" name="uam_desired_exp3" output="screen">
        <param name="hover_z" value="1.0" />
        <param name="hover_yaw_deg" value="0.0" />
        <!-- exp3 起飞点和方形首角都来自启动时当前 local pose；后续移动是在该当前位置基础上做相对 x/y 偏移。 -->
        <param name="square_side_length" value="0.7" />
        <param name="edge_time" value="7.0" />
        <param name="settle_time" value="8.0" />
        <param name="recovery_time" value="2.0" />

        <!-- ============================================= TD慢参考生成器 ============================================= -->
        <!-- true 时，位置期望先经过 TD 平滑；false 时直接发布 raw target。 -->
        <param name="use_td_reference" value="true" />
        <!-- TD 的等效带宽，越小参考越慢越柔；起飞仍晃时优先降到 0.18。 -->
        <param name="td_bandwidth_hz" value="0.18" />
        <!-- x/y 方向参考加速度上限，单位 m/s^2；越小越不容易给姿态环突然横向指令。 -->
        <param name="td_accel_limit_xy" value="0.04" />
        <!-- z 方向参考加速度上限，单位 m/s^2；越小起飞越柔。 -->
        <param name="td_accel_limit_z" value="0.04" />
        <!-- x/y 方向参考速度上限，单位 m/s；方形段也会受这个速度上限约束。 -->
        <param name="td_vel_limit_xy" value="0.05" />
        <!-- z 方向参考速度上限，单位 m/s；起飞太慢但误差小，可小幅提高。 -->
        <param name="td_vel_limit_z" value="0.05" />
        <!-- settle 完成判据：实际位置与当前 TD 位置期望的水平误差阈值，单位 m。 -->
        <param name="settle_reach_xy_m" value="0.10" />
        <!-- settle 完成判据：实际位置与当前 TD 高度期望的 z 误差阈值，单位 m。 -->
        <param name="settle_reach_z_m" value="0.10" />
        <!-- 进入误差阈值后至少稳定保持这么久，才允许进入方形轨迹和机械臂扰动，单位 s。 -->
        <param name="settle_min_hold_s" value="2.0" />

        <param name="arm1_offset_deg" value="0.0" />
        <param name="arm1_amp_deg" value="10.0" />
        <param name="arm1_period" value="3.5" />
        <param name="arm1_phase_deg" value="90.0" />
        <param name="arm1_sign" value="1.0" />
        <param name="arm2_offset_deg" value="0.0" />
        <param name="arm2_amp_deg" value="15.0" />
        <param name="arm2_period" value="3.5" />
        <param name="arm2_phase_deg" value="0.0" />
        <param name="arm2_sign" value="1.0" />
        <param name="hand_hold_deg" value="0.0" />

        <!-- ====================================== 实验三原有真值保护 ====================================== -->
        <param name="enable_protection" value="true" />
        <param name="protection_auto_land" value="false" />
        <param name="max_pose_disagreement" value="0.6" />
        <param name="max_tracking_error" value="1.0" />
        <param name="max_altitude_drop" value="0.3" />
        <param name="protection_trigger_cycles" value="10" />
        <param name="protection_hold_time" value="2.0" />

        <!-- ==================================== 新增 freshness 防炸机保护 ==================================== -->
        <!-- 超过这个时间没新鲜数据，就认为 arm_base/local pose 不可靠 -->
        <param name="pose_timeout_sec" value="0.8" />
        <!-- 连续多少次检测到位姿超时后，才真正触发保护 -->
        <param name="pose_loss_limit" value="10" />

        <!-- ==============================================数据回传丢失保护================================================= -->
        <!-- ======================================= 三维总数据（模长）回传丢失保护 ===================================-->
        <!-- 在这么长一段时间内，检查飞机实际位置有没有明显动 -->
        <param name="freeze_window_sec" value="1.0" />
        <!-- 在 freeze_window_sec 这个时间窗里，如果实际位置总位移小于这个值，就认为“几乎没动” -->
        <param name="freeze_motion_threshold_m" value="0.03" />
        <!-- 只有当“当前还没到目标点”时，冻结保护才有意义 -->
        <param name="freeze_arrive_threshold_m" value="0.15" />
        <!-- 冻结故障连续命中多少次后，进入 safety_hold -->
        <param name="freeze_trigger_cycles" value="3" />
        <!-- 进入 safety_hold 后，如果异常还持续，再连续多少次后升级到 safety_landing -->
        <param name="freeze_escalate_cycles" value="6" />

        <!-- =========================================== 单Z轴数据回传丢失保护 ============================================-->
        <!-- 专门针对高度方向的冻结保护。如果 z 方向目标误差大于这个值，说明高度还差很多 -->
        <param name="z_freeze_error_threshold_m" value="0.20" />
        <!-- 在检测时间窗里，如果实际 z 位移小于这个值，就认为高度基本没变化 -->
        <param name="z_freeze_motion_threshold_m" value="0.03" />

        <!-- ============================================= 安全姿态参数 ================================================ -->
        <!-- 保护触发后，机械臂回到这组安全角，停止继续给机体叠加扰动 -->
        <param name="safety_hold_arm1_deg" value="0.0" />
        <param name="safety_hold_arm2_deg" value="0.0" />
        <param name="safety_hold_hand_deg" value="0.0" />
    </node>
</launch>
