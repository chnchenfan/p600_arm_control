<?xml version="1.0"?>
<launch>
    <rosparam file="$(find uam_message)/config/arm_info_init.yaml" command="load" />
    <node pkg="arm_control" type="motors_simulation" name="motors_simulation" output="screen" />
    <node pkg="arm_control" type="uam_desired_exp4" name="uam_desired_exp4" output="screen">
        <param name="hover_z" value="1.0" />
        <param name="hover_yaw_deg" value="0.0" />
        <!-- false 时不追 target，只围绕初始悬停点飞一个简单闭环，用于先验证起飞、链路和保护 -->
        <param name="use_targets" value="false" />
        <!-- ==========================================状态机切换的时间间隔=============================================== -->
        <!-- 
            起飞后流程是：settle => axis_move_y => axis_move_x => target1(pass -> depart,+x 2cm)
                        => target1 -> target0 中间继续走 axis_move_y -> axis_move_x
                        => target0(pass -> depart) => target2(pass -> depart,-x 2cm)
                        => final_hold 悬停，不降落
        -->
        <!-- 起飞后到正式开始任务前的稳定悬停时间。 -->
        <param name="settle_time" value="3.0" />
        <!-- 从当前点飞到“钩子前准备点”的时间 -->
        <param name="approach_time" value="3.0" />
        <!-- “过钩子工作点”的时间 -->
        <param name="pass_time" value="2.0" />
        <!-- 过完钩子后的退出时间 -->
        <param name="depart_time" value="3.0" />
        <!-- 当前这版逻辑最后是 final_hold，不再返回悬停点，这个参数先注释保留。 -->
        <!-- <param name="return_time" value="3.0" /> -->
        <param name="landing_z" value="0.5" />
        <!-- =============================================targets目标和自身位置更新的新鲜度保护================================================ -->
        <!-- 超过这个时间没新鲜数据，就认为动捕不可靠 -->
        <param name="target_pose_timeout_sec" value="0.8" />
        <!-- 连续多少次检测到 target/位姿超时后，才真正触发保护。 -->
        <param name="target_loss_limit" value="10" />
        <!-- settle 段起飞时，xy 参考的专用限幅。值越小，起飞时横向越保守 -->
        <param name="settle_takeoff_step_limit_xy" value="0.01" />
        <!-- settle 段起飞时，z 参考的专用限幅。值越小，起飞上升越慢 -->
        <param name="settle_takeoff_step_limit_z" value="0.01" />
        <param name="base_step_limit_xy" value="0.03" />
        <param name="base_step_limit_z" value="0.02" />
        <param name="fixed_arm1_deg" value="0.0" />
        <param name="fixed_arm2_deg" value="0.0" />
        <param name="fixed_hand_deg" value="25.0" />
        <!-- ==============================================数据回传丢失保护================================================= -->
        <!-- ======================================= 三维总数据（模长）回传丢失保护 ===================================-->
        <!-- 在这么长一段时间内，检查飞机实际位置有没有明显动 
        用来抓这种故障：动捕刚体丢了,但还一直在发最后一帧,飞机以为自己没动，于是一直追目标-->
        <param name="freeze_window_sec" value="1.0" />
        <!-- 在 freeze_window_sec 这个时间窗里，如果实际位置总位移小于这个值，就认为“几乎没动” -->
        <param name="freeze_motion_threshold_m" value="0.03" />
        <!-- 只有当“当前还没到目标点”时，冻结保护才有意义。如果当前位置和目标点的误差大于这个值，说明还没到,这时如果飞机又长时间不动，就可判定异常 -->
        <param name="freeze_arrive_threshold_m" value="0.15" />
        <!-- 冻结故障连续命中多少次后，进入 safety_hold。 -->
        <param name="freeze_trigger_cycles" value="3" />
        <!-- 进入 safety_hold 后，如果异常还持续，再连续多少次后升级到 safety_landing -->
        <param name="freeze_escalate_cycles" value="6" />
        <!-- =========================================== 单Z轴数据回传丢失保护 ============================================-->
        <!-- 专门针对高度方向的冻结保护。如果 z 方向目标误差大于这个值,说明高度还差很多 -->
        <param name="z_freeze_error_threshold_m" value="0.20" />
        <!-- 在检测时间窗里，如果实际 z 位移小于这个值,就认为高度基本没变化 -->
        <param name="z_freeze_motion_threshold_m" value="0.03" />
        <!-- ============================ 所有“先走 y，再走 x”的特殊转场共用这两个时间 =============================== -->
        <!-- 含义：“先走 y” 这一段要走多久.值越大，y 向移动越慢;值越小，y 向移动越快 -->
        <param name="first_target1_axis_move_time_y" value="2.0" />
        <!-- 含义：“再走 x” 这一段要走多久.值越大，x 向移动越慢;值越小，x 向移动越快 -->
        <param name="first_target1_axis_move_time_x" value="2.0" />
        <!-- use_targets=false 时，闭环第一段和第三段的 y 偏移 -->
        <param name="loop_offset_y_m" value="0.50" />
        <!-- use_targets=false 时，闭环第二段和第三段的 x 偏移 -->
        <param name="loop_offset_x_m" value="0.50" />

        <param name="base_world_pose_topic" value="/vrpn_client_node/arm_base/pose" />
        <param name="local_pose_topic" value="/mavros/local_position/pose" />

        <rosparam param="target_names">[target0, target1, target2]</rosparam>
        <rosparam param="visit_sequence">[1, 0, 2]</rosparam>

        <!-- target rigid body 原点 -> 钩子真正工作点 的偏移 -->
        <rosparam param="targets/target0/first_pass_approach_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <rosparam param="targets/target0/first_pass_work_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <rosparam param="targets/target0/first_pass_depart_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <!-- 当前单轮路径不再第二次经过 target0，second_pass 先注释保留。 -->
        <!-- <rosparam param="targets/target0/second_pass_approach_offset_xyz">[0.00, 0.00, 0.08]</rosparam> -->
        <!-- <rosparam param="targets/target0/second_pass_work_offset_xyz">[0.00, 0.00, 0.03]</rosparam> -->
        <!-- <rosparam param="targets/target0/second_pass_depart_offset_xyz">[-0.05, 0.00, 0.08]</rosparam> -->

        <rosparam param="targets/target1/first_pass_approach_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <rosparam param="targets/target1/first_pass_work_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <!-- target1 之后先沿 +x 飞 2cm -->
        <rosparam param="targets/target1/first_pass_depart_offset_xyz">[0.02, 0.00, 0.05]</rosparam>
        <!-- 当前单轮路径不再第二次经过 target1，second_pass 先注释保留。 -->
        <!-- <rosparam param="targets/target1/second_pass_approach_offset_xyz">[0.00, 0.00, 0.08]</rosparam> -->
        <!-- <rosparam param="targets/target1/second_pass_work_offset_xyz">[0.00, 0.00, 0.03]</rosparam> -->
        <!-- <rosparam param="targets/target1/second_pass_depart_offset_xyz">[0.05, 0.00, 0.08]</rosparam> -->

        <rosparam param="targets/target2/first_pass_approach_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <rosparam param="targets/target2/first_pass_work_offset_xyz">[0.00, 0.00, 0.05]</rosparam>
        <!-- target2 之后先沿 -x 飞 2cm，然后 final_hold -->
        <rosparam param="targets/target2/first_pass_depart_offset_xyz">[-0.02, 0.00, 0.05]</rosparam>
        <rosparam param="targets/target2/second_pass_approach_offset_xyz">[0.00, 0.00, 0.08]</rosparam>
        <rosparam param="targets/target2/second_pass_work_offset_xyz">[0.00, 0.00, 0.03]</rosparam>
        <rosparam param="targets/target2/second_pass_depart_offset_xyz">[-0.05, 0.00, 0.08]</rosparam>
    </node>
</launch>
